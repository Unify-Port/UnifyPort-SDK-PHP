<?xml version="1.0"?>
<ruleset name="UnifyPort PHP SDK">
    <description>PSR-12 checks for source, tests, scripts, and examples.</description>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <file>src</file>
    <file>tests</file>
    <file>scripts</file>
    <file>examples</file>
    <rule ref="PSR12">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>scripts/generate.php</exclude-pattern>
    </rule>
</ruleset>
